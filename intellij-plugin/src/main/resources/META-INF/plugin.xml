<idea-plugin>
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.lineMarkerProvider
            language="kotlin"
            implementationClass="io.github.akshaychordiya.pose.ide.PoseLineMarkerProvider" />
    </extensions>

    <!--
        We only touch Kotlin PSI (KtNamedFunction, KtFile.declarations, packageFqName) —
        no semantic analysis, no BindingContext, no resolveTo*() — so we're K2-safe.
        Modern Android Studio defaults to K2 mode; without this the plugin is disabled.
    -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true" />
    </extensions>
</idea-plugin>
